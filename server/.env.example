# Web Push VAPID 密钥（首次启动自动生成，也可手动配置）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# 视觉识别 API（订阅截图 OCR，OpenAI 兼容接口，默认智谱 GLM）
# 未配置时 OCR 接口返回 503，前端提示手动填写
VISION_API_KEY=
# 模型可换：glm-5.3-flash（原生多模态，推荐）/ glm-4.6v-flashx（视觉专线，更便宜）
VISION_MODEL=glm-5.3-flash
# 可选：切换服务地址（如走 OpenRouter 等聚合平台时改为此处 + 对应模型名）
# VISION_API_BASE=https://open.bigmodel.cn/api/paas/v4

# 服务端口
PORT=3001